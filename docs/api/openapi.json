{
  "components": {
    "schemas": {
      "BatchError": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": ["code", "message"],
        "title": "BatchError",
        "type": "object"
      },
      "BatchOut": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/BatchResult"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": ["results"],
        "title": "BatchOut",
        "type": "object"
      },
      "BatchResult": {
        "description": "One row of a batch, in the order it was submitted.",
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BatchError"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "index": {
            "title": "Index",
            "type": "integer"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["index", "status"],
        "title": "BatchResult",
        "type": "object"
      },
      "EntryIn": {
        "description": "Everything but the address has a default.\n\nA minimal client can post {\"url\": \"...\"} and nothing else, which\nmatters more once custom fields arrive.",
        "properties": {
          "fields": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fields"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "notes": {
            "default": "",
            "title": "Notes",
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          },
          "title": {
            "default": "",
            "title": "Title",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": ["url"],
        "title": "EntryIn",
        "type": "object"
      },
      "EntryOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "fields": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Fields",
            "type": "object"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "image": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "title": "Notes",
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "url",
          "title",
          "notes",
          "tags",
          "fields",
          "image",
          "created_at",
          "updated_at"
        ],
        "title": "EntryOut",
        "type": "object"
      },
      "HealthOut": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": ["status", "service", "version", "message"],
        "title": "HealthOut",
        "type": "object"
      },
      "ImageOut": {
        "description": "What a client needs to show the picture, and nothing more.\n\nNeither copy of the bytes appears here. The original is archival\nand never leaves the server; the display copy is fetched from\n`url`, which is access-controlled.",
        "properties": {
          "height": {
            "title": "Height",
            "type": "integer"
          },
          "url": {
            "title": "Url",
            "type": "string"
          },
          "width": {
            "title": "Width",
            "type": "integer"
          }
        },
        "required": ["url", "width", "height"],
        "title": "ImageOut",
        "type": "object"
      },
      "Input": {
        "properties": {
          "limit": {
            "default": 100,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "minimum": 0,
            "title": "Offset",
            "type": "integer"
          }
        },
        "title": "Input",
        "type": "object"
      },
      "LoginIn": {
        "properties": {
          "identifier": {
            "title": "Identifier",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": ["identifier", "password"],
        "title": "LoginIn",
        "type": "object"
      },
      "PagedEntryOut": {
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/EntryOut"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": ["items", "count"],
        "title": "PagedEntryOut",
        "type": "object"
      },
      "TokenCreateIn": {
        "description": "A name, and optionally a date it should stop working.",
        "properties": {
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": ["name"],
        "title": "TokenCreateIn",
        "type": "object"
      },
      "TokenExchangeIn": {
        "description": "Credentials traded for a token, for a client with no session.\n\n`identifier` and `password` are the same pair `login` takes; the\nname is the one the clients page will show beside the token.",
        "properties": {
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "identifier": {
            "title": "Identifier",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": ["name", "identifier", "password"],
        "title": "TokenExchangeIn",
        "type": "object"
      },
      "TokenOut": {
        "description": "The only time the raw token exists outside the client.\n\nOnly a hash is stored, so a client that loses this value has to\nmake another token; nobody can look it up, including whoever runs\nthis Hrček.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": ["id", "name", "token", "created_at", "expires_at"],
        "title": "TokenOut",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "title": "Email",
            "type": "string"
          }
        },
        "required": ["email", "display_name"],
        "title": "UserOut",
        "type": "object"
      }
    },
    "securitySchemes": {
      "ApiTokenAuth": {
        "scheme": "bearer",
        "type": "http"
      },
      "SessionAuth": {
        "in": "cookie",
        "name": "sessionid",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "",
    "title": "Hrček API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "operationId": "login",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Login",
        "tags": ["auth"]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "security": [
          {
            "ApiTokenAuth": []
          },
          {
            "SessionAuth": []
          }
        ],
        "summary": "Logout",
        "tags": ["auth"]
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "current_user",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "ApiTokenAuth": []
          },
          {
            "SessionAuth": []
          }
        ],
        "summary": "Me",
        "tags": ["auth"]
      }
    },
    "/api/auth/tokens": {
      "post": {
        "description": "Make a bearer token for a script or another client.\n\nSession-authenticated only. A token that could mint tokens would\nmake revoking a leaked one pointless: the holder would simply issue\na replacement, and the original could be revoked without ending\ntheir access.",
        "operationId": "create_api_token",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenCreateIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            },
            "description": "Created"
          }
        },
        "security": [
          {
            "ApiTokenAuth": []
          },
          {
            "SessionAuth": []
          }
        ],
        "summary": "Create Api Token",
        "tags": ["auth"]
      }
    },
    "/api/auth/tokens/exchange": {
      "post": {
        "description": "Trade an email address and password for a bearer token.\n\nFor clients that cannot hold a session. A browser extension is the\ncase: Firefox sends `Origin: moz-extension://<uuid>` on every\nrequest, the uuid differs per install so it cannot be trusted in\nadvance, and Django refuses the origin before it reads anything\nelse — so an extension can sign in and then do nothing unsafe with\nthe session it got.\n\nThis route reads no session at all, which is also what makes it\nsafe without a CSRF check: there is no path through it that a\ncookie alone can take. A signed-in browser gains nothing here.",
        "operationId": "exchange_credentials_for_token",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenExchangeIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            },
            "description": "Created"
          }
        },
        "summary": "Exchange Credentials For Token",
        "tags": ["auth"]
      }
    },
    "/api/entries/": {
      "get": {
        "operationId": "list_entries",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedEntryOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "ApiTokenAuth": []
          },
          {
            "SessionAuth": []
          }
        ],
        "summary": "List Entries",
        "tags": ["entries"]
      },
      "post": {
        "operationId": "create_entry",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntryIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryOut"
                }
              }
            },
            "description": "OK"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryOut"
                }
              }
            },
            "description": "Created"
          }
        },
        "security": [
          {
            "ApiTokenAuth": []
          },
          {
            "SessionAuth": []
          }
        ],
        "summary": "Create Entry",
        "tags": ["entries"]
      }
    },
    "/api/entries/batch/": {
      "post": {
        "operationId": "create_entries",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/EntryIn"
                },
                "title": "Payload",
                "type": "array"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchOut"
                }
              }
            },
            "description": "OK"
          },
          "207": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchOut"
                }
              }
            },
            "description": "Multi-Status"
          }
        },
        "security": [
          {
            "ApiTokenAuth": []
          },
          {
            "SessionAuth": []
          }
        ],
        "summary": "Create Entries",
        "tags": ["entries"]
      }
    },
    "/api/entries/by-url/": {
      "get": {
        "description": "Answer the entry held at *url*, so a client can compare.\n\nPosting is an upsert, which leaves a client no way to ask what an\naddress currently says before writing over it. Listing and filtering\nclient-side is the wrong shape once somebody holds thousands of\nentries.\n\nDeclared before any /{id}/ route: whoever adds one must keep it\nbelow this, or \"by-url\" will be read as an id.",
        "operationId": "get_entry_by_url",
        "parameters": [
          {
            "in": "query",
            "name": "url",
            "required": true,
            "schema": {
              "title": "Url",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "ApiTokenAuth": []
          },
          {
            "SessionAuth": []
          }
        ],
        "summary": "Get Entry By Url",
        "tags": ["entries"]
      }
    },
    "/api/entries/{pk}/image": {
      "delete": {
        "operationId": "delete_entry_image",
        "parameters": [
          {
            "in": "path",
            "name": "pk",
            "required": true,
            "schema": {
              "title": "Pk",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "security": [
          {
            "ApiTokenAuth": []
          },
          {
            "SessionAuth": []
          }
        ],
        "summary": "Delete Entry Image",
        "tags": ["entries"]
      },
      "post": {
        "description": "Attach an uploaded picture, replacing any the entry had.\n\nMultipart rather than JSON: base64 in a body would inflate every\nupload by a third for no gain.",
        "operationId": "upload_entry_image",
        "parameters": [
          {
            "in": "path",
            "name": "pk",
            "required": true,
            "schema": {
              "title": "Pk",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "format": "binary",
                    "title": "File",
                    "type": "string"
                  }
                },
                "required": ["file"],
                "title": "FileParams",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "ApiTokenAuth": []
          },
          {
            "SessionAuth": []
          }
        ],
        "summary": "Upload Entry Image",
        "tags": ["entries"]
      }
    },
    "/api/health": {
      "get": {
        "description": "Report that the service is up, in the caller's language.",
        "operationId": "health",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Health",
        "tags": ["core"]
      }
    }
  },
  "servers": []
}
