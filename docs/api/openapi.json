    "/api/entries/batch/": {
      "post": {
        "operationId": "create_entries",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/EntryIn"
