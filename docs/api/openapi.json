{
  "components": {
    "schemas": {
      "BatchError": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": ["code", "message"],
        "title": "BatchError",
        "type": "object"
      },
      "BatchOut": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/BatchResult"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": ["results"],
        "title": "BatchOut",
        "type": "object"
      },
      "BatchResult": {
        "description": "One row of a batch, in the order it was submitted.",
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BatchError"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "index": {
            "title": "Index",
            "type": "integer"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["index", "status"],
        "title": "BatchResult",
        "type": "object"
      },
      "EntryIn": {
        "description": "Everything but the address has a default.\n\nA minimal client can post {\"url\": \"...\"} and nothing else, which\nmatters more once custom fields arrive.",
        "properties": {
          "fields": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fields"
          },
          "notes": {
            "default": "",
            "title": "Notes",
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          },
          "title": {
            "default": "",
            "title": "Title",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": ["url"],
        "title": "EntryIn",
        "type": "object"
      },
      "EntryOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "fields": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Fields",
            "type": "object"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "notes": {
            "title": "Notes",
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "url",
          "title",
          "notes",
          "tags",
          "fields",
          "created_at",
          "updated_at"
        ],
        "title": "EntryOut",
        "type": "object"
      },
      "HealthOut": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": ["status", "service", "version", "message"],
        "title": "HealthOut",
        "type": "object"
      },
      "Input": {
        "properties": {
          "limit": {
            "default": 100,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "minimum": 0,
            "title": "Offset",
            "type": "integer"
          }
        },
        "title": "Input",
        "type": "object"
      },
      "LoginIn": {
        "properties": {
          "identifier": {
            "title": "Identifier",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": ["identifier", "password"],
        "title": "LoginIn",
        "type": "object"
      },
      "PagedEntryOut": {
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/EntryOut"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": ["items", "count"],
        "title": "PagedEntryOut",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "title": "Email",
            "type": "string"
          }
        },
        "required": ["email", "display_name"],
        "title": "UserOut",
        "type": "object"
      }
    },
    "securitySchemes": {
      "ApiTokenAuth": {
        "scheme": "bearer",
        "type": "http"
      },
      "SessionAuth": {
        "in": "cookie",
        "name": "sessionid",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "",
    "title": "Hrček API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
